+// POST only acknowledges upload admission. COMPLETE must independently accept the
+// registration before a media receipt (or multi-photo FORWARD) can be returned.
+function assertUploadComplete(result: UploadToLocoResult, expectedChatId: string): void {
+  if (result.postStatusCode !== 0 || !result.completePacket) {
+    throw new LocoResponseError('Media upload has no successful POST/COMPLETE receipt', 'transient_or_unknown')
+  }
+  assertLocoOk(result.completePacket, 'COMPLETE')
+  const chatLog = result.completePacket.body.chatLog as Record<string, unknown> | undefined
+  if (chatLog?.chatId !== undefined && longToString(chatLog.chatId) !== expectedChatId) {
+    throw new LocoResponseError('COMPLETE chat ID does not match requested chat', 'transient_or_unknown')
+  }
+}
